      ]
    },
    {
      "name": "MFA",
      "item": [
        {
          "name": "Get MFA Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/mfa/status",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "mfa", "status"]
            },
            "description": "Returns { mfaEnabled: boolean } for the current user."
          }
        },
        {
          "name": "Begin Enrolment",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/mfa/enrol",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "mfa", "enrol"]
            },
            "description": "Generates a new TOTP secret for the user (saved but not yet active) and returns { secret, qrCodeBase64, otpAuthUrl }. Scan qrCodeBase64 (a data:image/png;base64 PNG) or otpAuthUrl with an authenticator app, then call Confirm Enrolment with a generated code. MFA is NOT enabled until confirmed."
          }
        },
        {
          "name": "Confirm Enrolment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": 123456\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/mfa/enrol/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "mfa", "enrol", "confirm"]
            },
            "description": "code is the current 6-digit TOTP from the authenticator app used in Begin Enrolment. On success, enables MFA and returns a List<String> of 8 single-use backup codes — shown once, store them now."
          }
        },
        {
          "name": "Disable MFA",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": 123456\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/mfa/disable",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "mfa", "disable"]
            },
            "description": "code must be a currently-valid TOTP code (backup codes are not accepted here). Clears mfaEnabled/secret/backup codes on success (204 No Content)."
          }
        }
      ]
    },
    {
      "name": "Client Portal (Public)",
      "item": [
        {
          "name": "Get Public Invoice",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/public/invoices/{{shareToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "public", "invoices", "{{shareToken}}"]
            },
            "description": "Unauthenticated — the UUID share token in the URL IS the credential (invoices.share_token column, set automatically on every invoice). There is currently no authenticated endpoint that surfaces an invoice's share token; fetch it directly from the DB for testing:\n  SELECT share_token FROM invoices WHERE id = '<invoiceId>';\n\nReturns a client-facing view of the invoice (no internal org/user fields). stripeCheckoutUrl is always null for now — Stripe checkout isn't wired up on the portal yet."
          }
        },
        {
          "name": "Download Public Invoice PDF",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/public/invoices/{{shareToken}}/pdf",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "public", "invoices", "{{shareToken}}", "pdf"]
            },
            "description": "Same PDF as the authenticated download, gated only by the share token. Use \"Send and Download\" in Postman to save the file."
          }
        }
      ]
    }
  ]
}

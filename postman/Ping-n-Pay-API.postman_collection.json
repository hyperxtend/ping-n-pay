    {
      "name": "Invoices",
      "item": [
        {
          "name": "List Invoices",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/invoices",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "invoices"]
            },
            "description": "Lightweight summary projection (no line items) for the whole org."
          }
        },
        {
          "name": "Get Invoice by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/invoices/{{invoiceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "invoices", "{{invoiceId}}"]
            },
            "description": "Full invoice detail including line items, client, and running balance."
          }
        },
        {
          "name": "Create Invoice",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"issueDate\": \"2026-08-14\",\n  \"dueDate\": \"2026-09-13\",\n  \"currency\": \"GBP\",\n  \"discountAmount\": 0,\n  \"notes\": \"Thanks for your business!\",\n  \"items\": [\n    {\n      \"description\": \"Consulting — August\",\n      \"quantity\": 10,\n      \"unitPrice\": 150.00,\n      \"taxRate\": 20\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/invoices",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "invoices"]
            },
            "description": "Creates a new DRAFT invoice. Run Clients > Create Client first (or set {{clientId}} manually) so clientId resolves. At least one line item is required; taxRate is a percentage (20 = 20%) and defaults to 0 if omitted."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('invoiceId', pm.response.json().id);",
                  "}",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Invoice",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Updated notes — please pay within 30 days.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/invoices/{{invoiceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "invoices", "{{invoiceId}}"]
            },
            "description": "Only DRAFT invoices can be edited. All fields are optional — send only what you want to change; omitted fields are left as-is."
          }
        },
        {
          "name": "Update Invoice Status",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/invoices/{{invoiceId}}/status?status=SENT",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "invoices", "{{invoiceId}}", "status"],
              "query": [
                {
                  "key": "status",
                  "value": "SENT",
                  "description": "One of DRAFT, SENT, PARTIALLY_PAID, PAID, OVERDUE, VOID. Must be a legal transition from the invoice's current status (e.g. DRAFT -> SENT or VOID; SENT -> PARTIALLY_PAID, PAID, OVERDUE or VOID)."
                }
              ]
            },
            "description": "Transitions the invoice's lifecycle status. See InvoiceStatus.ALLOWED_TRANSITIONS in the backend for the full state machine."
          }
        },
        {
          "name": "Delete Invoice",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/invoices/{{invoiceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "invoices", "{{invoiceId}}"]
            },
            "description": "Only DRAFT invoices can be deleted."
          }
        },
        {
          "name": "Download Invoice PDF",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/invoices/{{invoiceId}}/pdf",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "invoices", "{{invoiceId}}", "pdf"]
            },
            "description": "Streams a generated PDF of the invoice (application/pdf). In Postman, use \"Send and Download\" to save the file rather than viewing the raw response."
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "List Payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/payments",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "payments"]
            },
            "description": "All payments recorded for the current user's organisation."
          }
        },
        {
          "name": "List Payments by Invoice",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/payments/invoice/{{invoiceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "payments", "invoice", "{{invoiceId}}"]
            }
          }
        },
        {
          "name": "Record Manual Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1800.00,\n  \"paymentMethod\": \"BANK_TRANSFER\",\n  \"reference\": \"REF-001\",\n  \"notes\": \"Paid via bank transfer\",\n  \"paidAt\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/payments/invoice/{{invoiceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "payments", "invoice", "{{invoiceId}}"]
            },
            "description": "paymentMethod is one of BANK_TRANSFER, CARD, CASH, CHEQUE, STRIPE, OTHER. paidAt defaults to now() if null."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('paymentId', pm.response.json().id);",
                  "}",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Stripe Checkout Session",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/payments/invoice/{{invoiceId}}/stripe-checkout",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "payments", "invoice", "{{invoiceId}}", "stripe-checkout"]
            },
            "description": "Requires STRIPE_SECRET_KEY to be configured on the backend. Returns a Stripe-hosted checkout URL."
          }
        },
        {
          "name": "Stripe Webhook (signature-verified)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Stripe-Signature",
                "value": "{{stripeSignature}}",
                "description": "Generate a real value with `stripe listen --forward-to localhost:8080/api/v1/payments/stripe-webhook` and the Stripe CLI — this endpoint verifies the signature against STRIPE_WEBHOOK_SECRET, so a hand-typed value will be rejected."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_test\",\n  \"type\": \"checkout.session.completed\",\n  \"data\": { \"object\": {} }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/payments/stripe-webhook",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "payments", "stripe-webhook"]
            },
            "description": "Not for manual testing from Postman — included for completeness. Use the Stripe CLI to forward real signed webhook events instead."
          }
        }
      ]
    },
    {
      "name": "Notification Rules",
      "item": [
        {
          "name": "List Notification Rules",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/notification-rules",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "notification-rules"]
            }
          }
        },
        {
          "name": "Create Notification Rule",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"3 days before due\",\n  \"triggerDaysOffset\": -3,\n  \"channels\": [\"EMAIL\", \"IN_APP\"],\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/notification-rules",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "notification-rules"]
            },
            "description": "triggerDaysOffset is relative to the invoice due date: negative = before due, 0 = on due date, positive = overdue. channels is a non-empty set of EMAIL, SMS, IN_APP, WHATSAPP."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('notificationRuleId', pm.response.json().id);",
                  "}",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Notification Rule",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"3 days before due\",\n  \"triggerDaysOffset\": -3,\n  \"channels\": [\"EMAIL\", \"IN_APP\", \"SMS\"],\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/notification-rules/{{notificationRuleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "notification-rules", "{{notificationRuleId}}"]
            }
          }
        },
        {
          "name": "Delete Notification Rule",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/notification-rules/{{notificationRuleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "notification-rules", "{{notificationRuleId}}"]
            }
          }
        }
      ]
    },

{
  "info": {
    "_postman_id": "5fe250ec-833a-46de-a910-1498f23447ac",
    "name": "Ping 'n Pay API",
    "description": "REST API for Ping 'n Pay — invoicing + overdue payment notifications.\n\nRun \"Auth > Login\" (or \"Auth > Register\" first) to populate {{accessToken}} for the rest of the collection automatically. Requests that create resources (Create Client, Create Invoice, Record Payment, Create Notification Rule) auto-populate the corresponding {{...Id}} variable used by later requests in that folder.\n\nIf the logged-in user has MFA enabled, Login instead populates {{mfaPendingToken}} — run Auth > Verify MFA with a TOTP/backup code to complete login and populate {{accessToken}} as normal.\n\nBase URL defaults to the local dev backend (http://localhost:8080/api) per the project README.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "organisationId", "value": "", "type": "string" },
    { "key": "clientId", "value": "", "type": "string" },
    { "key": "invoiceId", "value": "", "type": "string" },
    { "key": "notificationRuleId", "value": "", "type": "string" },
    { "key": "paymentId", "value": "", "type": "string" },
    { "key": "mfaPendingToken", "value": "", "type": "string" },
    { "key": "shareToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\",\n  \"email\": \"ada@example.com\",\n  \"password\": \"changeme123\",\n  \"organisationName\": \"Analytical Engines Ltd\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "register"]
            },
            "description": "Registers a new organisation and its first admin user. Returns an access/refresh token pair, same shape as Login."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "    pm.collectionVariables.set('userId', data.user.id);",
                  "    pm.collectionVariables.set('organisationId', data.user.organisationId);",
                  "}",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada@example.com\",\n  \"password\": \"changeme123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "login"]
            },
            "description": "Authenticates with email + password. Run this first — the test script saves the access token into {{accessToken}} for every other request in the collection.\n\nIf the account has MFA enabled, the response instead has mfaRequired=true and no accessToken/user — the test script saves mfaPendingToken instead. Follow up with Auth > Verify MFA to finish logging in."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.mfaRequired) {",
                  "        pm.collectionVariables.set('mfaPendingToken', data.mfaPendingToken);",
                  "        console.log('MFA required — run Auth > Verify MFA next.');",
                  "    } else {",
                  "        pm.collectionVariables.set('accessToken', data.accessToken);",
                  "        pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "        pm.collectionVariables.set('userId', data.user.id);",
                  "        pm.collectionVariables.set('organisationId', data.user.organisationId);",
                  "    }",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify MFA",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mfaPendingToken\": \"{{mfaPendingToken}}\",\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/mfa-verify",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "mfa-verify"]
            },
            "description": "Completes login after Login returned mfaRequired=true. code accepts either the current 6-digit TOTP code or one of the 8 single-use backup codes issued at enrolment (backup codes are consumed on use). mfaPendingToken expires after 5 minutes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "    pm.collectionVariables.set('userId', data.user.id);",
                  "    pm.collectionVariables.set('organisationId', data.user.organisationId);",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
